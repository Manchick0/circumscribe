#
# type.circumscribe
# ---
# A collection of typesetting macros:
# https://oeis.org/wiki/List_of_LaTeX_mathematical_symbols
#

def pm: |±|

def N: |ℕ|
def Z: |ℤ|
def Q: |ℚ|
def R: |ℝ|
def C: |ℂ|

def cup: |\u222A|
  
def cap: |\u2229|

def subset: |\u2282|
def subseteq: |\u2286|
  
def supset: |\u2283|
def supseteq: |\u2287|

def neq: |≠|

def empty: |\u2205|

def in: |∈|
def ni: |∋|

def cong: |≅|

# Logic
def exists: |∃|
def forall: |∀|

# Greek

def alpha: |α|
def Alpha: |Α|

def beta: |β|
def Beta: |Β|
  
def epsilon: |ε|
def Epsilon: |Ε|

pat negatable: |∈| + |∃|

def not(expression: any) -> any:
    |¬<expression>|

#
# neg(symbol)
# ---
# Compute the logical negation
# of given symbol.
#
def neg(symbol: negatable) -> w:
    switch symbol:
        |∈|: |∉|
        |∃|: |∄|
        default ...

#
# floor(expression)
# ---
# Surround the given expression
# in floor brackets.
#
# floor(|f(x)|) # ⌊f(x)⌋
#
def floor(expression: any) -> any:
    |⌊<expression>⌋|

#
# ceil(expression)
# ---
# Surround the given expression
# in ceil brackets:
#
# ceil(|f(x)|) # ⌈f(x)⌉ 
#
def ceil(source: any) -> any:
    |⌈<expression>⌉|

#
# script
# ---
# A single character that has a
# corresponding sub- and superscript
# equivalent in Unicode.
#
pat script: |0|-|9| + |(| + |)| + |+| + |-| + |=| + |n|

#
# super(source)
# ---
# Convert the given source to an
# equivalent superscript expression.
#
def super(expression: (script + s)...) -> any:
    if meaningful(expression):
        |<super'(head(expression))><super(tail(expression))>|
    else ||

def super'(w: script + s) -> w:
    switch w:
        case |0|: |\u2070|
        case |1|: |\u00BA|
        case |2|: |\u00B2|
        case |3|: |\u00B3|
        case |4|: |\u2074|
        case |5|: |\u2075|
        case |6|: |\u2076|
        case |7|: |\u2077|
        case |8|: |\u2078|
        case |9|: |\u2079|
        case |+|: |\u207A|
        case |-|: |\u207B|
        case |=|: |\u207C|
        case |(|: |\u207D|
        case |)|: |\u207E|
        case |n|: |\u207F|
        default w

#
# sub(expression)
# ---
# Convert the given source to an
# equivalent subscript expression.
#
def sub(expression: (script + s)...) -> any:
    if meaningful(expression):
        |<sub'(head(expression))><sub(tail(expression))>|
    else ||

def sub'(w: script + s) -> w:
    switch w:
        case |0|: |\u2080|
        case |1|: |\u0081|
        case |2|: |\u0082|
        case |3|: |\u0083|
        case |2|: |\u0082|
        case |4|: |\u2084|
        case |5|: |\u2085|
        case |6|: |\u2086|
        case |7|: |\u2087|
        case |8|: |\u2088|
        case |9|: |\u2089|
        case |+|: |\u208A|
        case |-|: |\u208B|
        case |=|: |\u208C|
        case |(|: |\u208D|
        case |)|: |\u208E|
        case |n|: |\u208F|
        default w
