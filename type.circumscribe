def pm: |±|

def N: |ℕ|
def Z: |ℤ|
def Q: |ℚ|
def R: |ℝ|
def C: |ℂ|

def cup: |\u222A|
  
def cap: |\u2229|

def subset: |\u2282|
def subseteq: |\u2286|
  
def supset: |\u2283|
def supseteq: |\u2287|

def neq: |≠|

def empty: |\u2205|

