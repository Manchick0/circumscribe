#
# standard.circumscribe
# ---
# The standard library of circumscribe.
#
# The 'standard.circumscribe' is loaded before any
# userspace code, and contains documented macros
# and patterns that one may reference in their
# code.
#
# Circumscribe provides a set of native, intristic
# macros, suffixed with an apostrophe. The standard
# library wraps these in a documented layer
#
# The patterns defined in the standard libraries
# are referenced internally by circumscribe.
#

#
# w @since 0.1.0
# ---
# An alias for any character in the Unicode
# range from 'u0000' to 'u10FFFF'.
#
pat w: |\u0000|-|\u10FFFF|

#
# e @since 0.1.0
# ---
# An alias for the empty pattern '||'.
#
# It's often desired to construct a pattern in
# form of (x + ||), mirroring the '?' operator
# in a regular expression: (x + e)
#
# The empty pattern is often referred to as an
# *epsilon transition* in the formal language
# theory, hence the name.
#
# 'e' is the multiplicative identity.
#
pat e: ||

#
# never @since 0.1.0
# ---
# A pattern representing an empty set of
# languages. Not a single language is
# accepted by the never pattern.
#
# A 'raise' expression always evaluates
# to the never pattern. 'never' is the
# additive identity.
#
pat never: w & e

#
# any @since 0.1.0
# ---
# A pattern representing any possible snippet.
#
# The 'any' pattern is the default pattern for
# an un-annotated macro parameter. Please always
# consider a more suitable pattern for you needs
# before defaulting to any.
#
pat any: !never

#
# s @since 0.1.0
# ---
# A pattern matching a single ASCII
# whitespace character.
#
# It's often desired to include an 's'
# pattern in place of a literal space
# in a grammar:
#
# match |Hello,<s...><name: any>!| in src:
#     ...
#
pat s: |\u0009|-|\u000D| + |\u0020|

#
# boolean @since 0.1.0
# ---
# A pattern representing the two boolean
# literals, 'true' and 'false'.
#
# The boolean pattern is used extensively
# throughout Circumscribe. A snippet that
# satisfies the boolean pattern may appear,
# among others, in the condition of an 'if'
# expression.
#
pat boolean: |true| + |false|

#
# natural @since 0.1.0
# ---
# A pattern representing a natural number,
# including the literal zero.
#
# A snippet that satisfies the natural pattern
# may appear in arithmetic operations:
#
# (|5| * |5|) + (|100| / |10) - |1|
#
pat natural: |0| + (|1|-|9| * |0|-|9|...)

#
# lt @since 0.1.0
# ---
# An alias for the '<' symbol.
#
# In order to include a literal '<' in
# a circumscribed file, one has to escape
# it as follows:
#
# 5 <|\<|> 7
#
# Instead, it's recommended to use 'lt':
#
# 5 <lt> 7
#
def lt: |\u003C|

#
# gt @since 0.1.0
# ---
# An alias for the '>' symbol.
#
# While a literal '>' may appear unchanged
# in a circumscribed file, the 'gt' macro
# was included as a counterpart to the
# 'lt' macro for the sake of symmetry.
#
def gt: |\u003E|

#
# us @since 0.4.0
# ---
# An alias for the unit separator.
#
# It's often desired to use the 'us'
# in order to separate two parts of
# a 'list', or any similar data
# structure.
#
def us: |\u001F|
pat us: |\u001F|

#
# rs @since 0.4.0
# ---
# An alias for the record separator.
#
def rs: |\u001E|
pat rs: |\u001E|

#
# gs @since 0.4.0
# ---
# An alias for the group separator.
#
def gs: |\u001D|
pat gs: |\u001D|

#
# fs @since 0.4.0
# ---
# An alias for the file separator.
#
def fs: |\u001C|
pat fs: |\u001C|

#
# ord(w) @since 0.1.0
# ---
# Compute the Unicode codepoint of
# the given character.
#
def ord(w: w) -> natural:
    ord'(w)

#
# chr(point) @since 0.1.0
# ---
# Compute the Unicode character for
# the given codepoint.
#
def chr(point: natural) -> w:
    chr'(point)

#
# head(source) @since 0.1.0
# ---
# Returns the firstmost character
# of the given source:
#
# head(|Hello, World!|) = |H|
#
def head(source: any) -> w + e:
    head'(source)

#
# seqhead(sequence) @since 0.4.0
# ---
# Returns the head of the given
# sequence, which is the part up
# until the first unit separator:
#
# seqhead(|foo<us>bar<us>baz|) = |foo|
#
def seqhead(sequence: any) -> (w \ us)...:
    match |<head: (w \ us)...><us><any>| in sequence:
        head
    else sequence

#
# tail(source) @since 0.1.0 
# ---
# Returns the tail of the given
# source:
#
# tail(|Hello, World!|) = |ello, World!|
#
def tail(source: any) -> any:
    tail'(source)

#
# seqtail(sequence) @since 0.4.0
# ---
# Returns the tail of the given
# sequence, which is the part
# after the first unit separator:
#
# seqtail(|foo<us>bar<us>baz|) = |bar<us>baz|
#
def seqtail(sequence: any) -> any:
    match |<(w \ us)...><us><tail: any>| in sequence:
        tail
    else ||

#
# trim(source) @since 0.1.0
# ---
# Trim the trailing and leading whitespace
# from the given source.
#
def trim(source: any) -> any:
    trim'(source)

#
# length(source) @since 0.1.0
# ---
# Compute the length of the given source.
#
def length(source: any) -> natural:
    length'(source)

#
# reverse(source) @since 0.1.0
# ---
# Reverse the given source.
#
def reverse(source: any) -> any:
    reverse'(source)

#
# lowercase(source) @since 0.1.0
# ---
# Compute a snippet identical to the given
# source, with all letters replaced with
# their lowercase counterparts.
#
def lowercase(source: any) -> any:
    lowercase'(source)

#
# uppercase(source) @since 0.1.0
# ---
# Compute a snippet identical to the given
# source, with all letters replaced with
# their uppercase counterparts.
#
def uppercase(source: any) -> any:
    uppercase'(source)

#
# contains(source, snippet) @since 0.1.0
# ---
# Determine whether the given snippet
# appears in the given source.
#
def contains(source: any, snippet: any) -> boolean:
    contains'(source, snippet)

#
# read(path) @since 0.1.0
#            @impure
# ---
# Read the content of the given file.
# 
def read(path: any) -> any:
    read'(path)

#
# env(name) @since 0.1.0
#           @impure
# ---
# Return the value of the given environment
# variable, or an empty snippet if unset. 
#
def env(name: any) -> any:
    env'(name)

#
# meaningful(source) @since 0.1.0
# ---
# Determine whether the given source is
# non-empty.
#
def meaningful(source: any) -> boolean:
    if length(source) > |0|:
        |true|
    else |false|
